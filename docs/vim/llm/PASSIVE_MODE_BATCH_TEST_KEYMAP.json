[
  {
    "context": "Editor && vim_mode == false && vim_passive_mode == true",
    "bindings": {
      // =========================
      // SET 1: Selections (cmd-shift-[1..0])
      // =========================

      // Select inside any quotes (single, double, backticks)
      "cmd-shift-1": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::AnyQuotes",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around any quotes (includes the quotes)
      "cmd-shift-2": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::AnyQuotes",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside parentheses: (text) -> text
      "cmd-shift-3": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Parentheses",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around square brackets: [text] -> [text]
      "cmd-shift-4": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::SquareBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside curly braces: {text} -> text
      "cmd-shift-5": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::CurlyBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside angle brackets: <text> -> text
      "cmd-shift-6": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::AngleBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside word (alnum + underscore)
      "cmd-shift-7": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          ["vim::Word", { "ignore_punctuation": false }],
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside subword (camelCase parts), ignoring punctuation
      "cmd-shift-8": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          ["vim::Subword", { "ignore_punctuation": true }],
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside sentence
      "cmd-shift-9": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Sentence",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside paragraph
      "cmd-shift-0": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Paragraph",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],


      // =========================
      // SET 2: Delete (cmd-shift-alt-[1..0])
      // =========================

      // Delete inside any quotes
      "cmd-shift-alt-1": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::AnyQuotes"
        ]
      ],

      // Delete around parentheses (includes parentheses)
      "cmd-shift-alt-2": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": true }],
          "vim::Parentheses"
        ]
      ],

      // Delete inside square brackets
      "cmd-shift-alt-3": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::SquareBrackets"
        ]
      ],

      // Delete inside curly braces
      "cmd-shift-alt-4": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::CurlyBrackets"
        ]
      ],

      // Delete inside angle brackets
      "cmd-shift-alt-5": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::AngleBrackets"
        ]
      ],

      // Delete function argument
      "cmd-shift-alt-6": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::Argument"
        ]
      ],

      // Delete word
      "cmd-shift-alt-7": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          ["vim::Word", { "ignore_punctuation": false }]
        ]
      ],

      // Delete subword (camelCase part)
      "cmd-shift-alt-8": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          ["vim::Subword", { "ignore_punctuation": true }]
        ]
      ],

      // Delete sentence
      "cmd-shift-alt-9": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::Sentence"
        ]
      ],

      // Delete paragraph
      "cmd-shift-alt-0": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::Paragraph"
        ]
      ],


      // =========================
      // SET 3: Change (cmd-shift-ctrl-[1..0])
      // =========================

      // Change inside any quotes (delete + enter insert)
      "cmd-shift-ctrl-1": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          "vim::AnyQuotes"
        ]
      ],

      // Change around parentheses
      "cmd-shift-ctrl-2": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": true }],
          "vim::Parentheses"
        ]
      ],

      // Change inside square brackets
      "cmd-shift-ctrl-3": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          "vim::SquareBrackets"
        ]
      ],

      // Change inside curly braces
      "cmd-shift-ctrl-4": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          "vim::CurlyBrackets"
        ]
      ],

      // Change inside angle brackets
      "cmd-shift-ctrl-5": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          "vim::AngleBrackets"
        ]
      ],

      // Change around tag (e.g., <tag>text</tag>)
      "cmd-shift-ctrl-6": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": true }],
          "vim::Tag"
        ]
      ],

      // Change inside argument
      "cmd-shift-ctrl-7": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          "vim::Argument"
        ]
      ],

      // Change inside word
      "cmd-shift-ctrl-8": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          ["vim::Word", { "ignore_punctuation": false }]
        ]
      ],

      // Change inside subword
      "cmd-shift-ctrl-9": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          ["vim::Subword", { "ignore_punctuation": true }]
        ]
      ],

      // Change entire file (use with caution)
      "cmd-shift-ctrl-0": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          "vim::EntireFile"
        ]
      ],


      // =========================
      // SET 4: Yank / Comments / Case / Indent (cmd-shift-ctrl-alt-[1..0])
      // =========================

      // Yank inside any quotes
      "cmd-shift-ctrl-alt-1": [
        "action::Sequence",
        [
          "vim::PushYank",
          ["vim::PushObject", { "around": false }],
          "vim::AnyQuotes"
        ]
      ],

      // Yank around parentheses
      "cmd-shift-ctrl-alt-2": [
        "action::Sequence",
        [
          "vim::PushYank",
          ["vim::PushObject", { "around": true }],
          "vim::Parentheses"
        ]
      ],

      // Toggle comments inside quotes
      "cmd-shift-ctrl-alt-3": [
        "action::Sequence",
        [
          "vim::PushToggleComments",
          ["vim::PushObject", { "around": false }],
          "vim::AnyQuotes"
        ]
      ],

      // Toggle comments for entire file
      "cmd-shift-ctrl-alt-4": [
        "action::Sequence",
        [
          "vim::PushToggleComments",
          ["vim::PushObject", { "around": false }],
          "vim::EntireFile"
        ]
      ],

      // Uppercase inside word
      "cmd-shift-ctrl-alt-5": [
        "action::Sequence",
        [
          "vim::PushUppercase",
          ["vim::PushObject", { "around": false }],
          ["vim::Word", { "ignore_punctuation": false }]
        ]
      ],

      // Lowercase inside word
      "cmd-shift-ctrl-alt-6": [
        "action::Sequence",
        [
          "vim::PushLowercase",
          ["vim::PushObject", { "around": false }],
          ["vim::Word", { "ignore_punctuation": false }]
        ]
      ],

      // Opposite case inside word
      "cmd-shift-ctrl-alt-7": [
        "action::Sequence",
        [
          "vim::PushOppositeCase",
          ["vim::PushObject", { "around": false }],
          ["vim::Word", { "ignore_punctuation": false }]
        ]
      ],

      // Indent inside paragraph
      "cmd-shift-ctrl-alt-8": [
        "action::Sequence",
        [
          "vim::PushIndent",
          ["vim::PushObject", { "around": false }],
          "vim::Paragraph"
        ]
      ],

      // Outdent inside paragraph
      "cmd-shift-ctrl-alt-9": [
        "action::Sequence",
        [
          "vim::PushOutdent",
          ["vim::PushObject", { "around": false }],
          "vim::Paragraph"
        ]
      ],

      // Yank inside tag
      "cmd-shift-ctrl-alt-0": [
        "action::Sequence",
        [
          "vim::PushYank",
          ["vim::PushObject", { "around": false }],
          "vim::Tag"
        ]
      ]
    }
  }
]
