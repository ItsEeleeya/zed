[
  {
    "context": "Editor && vim_mode == false && vim_passive_mode == true",
    "bindings": {
      // ========================================
      // TEXT OBJECT SELECTIONS
      // ========================================
      // These bindings select text inside/around delimiters
      // Pattern: SwitchToVisualMode → PushObject → TextObject → SwitchToNormalPreservingSelections

      // --- QUOTES ---

      // Select inside single quotes: 'text' → text
      "cmd-'": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Quotes",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around single quotes: 'text' → 'text'
      "cmd-shift-'": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::Quotes",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside double quotes: "text" → text
      "cmd-shift-2": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::DoubleQuotes",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around double quotes: "text" → "text"
      "cmd-shift-alt-2": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::DoubleQuotes",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside backticks: `text` → text
      "cmd-`": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::BackQuotes",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // --- BRACKETS AND PARENTHESES ---

      // Select inside parentheses: (text) → text
      "cmd-9": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Parentheses",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around parentheses: (text) → (text)
      "cmd-shift-9": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::Parentheses",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside square brackets: [text] → text
      "cmd-[": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::SquareBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around square brackets: [text] → [text]
      "cmd-shift-[": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::SquareBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside curly braces: {text} → text
      "cmd-shift-]": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::CurlyBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around curly braces: {text} → {text}
      "cmd-shift-alt-]": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::CurlyBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside angle brackets: <text> → text
      "cmd-shift-,": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::AngleBrackets",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // --- WORDS ---

      // Select inside word: word
      "cmd-w": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Word",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around word (includes trailing space): word
      "cmd-shift-w": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::Word",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // --- OTHER TEXT OBJECTS ---

      // Select inside HTML/XML tag: <tag>text</tag> → text
      "cmd-t": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Tag",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select around HTML/XML tag: <tag>text</tag> → <tag>text</tag>
      "cmd-shift-t": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": true }],
          "vim::Tag",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside sentence
      "cmd-s": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Sentence",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // Select inside paragraph
      "cmd-p": [
        "action::Sequence",
        [
          "vim::SwitchToVisualMode",
          ["vim::PushObject", { "around": false }],
          "vim::Paragraph",
          "vim::SwitchToNormalPreservingSelections"
        ]
      ],

      // ========================================
      // OPERATOR + TEXT OBJECT COMBINATIONS
      // ========================================
      // These bindings perform operations on text objects
      // Pattern: Operator → PushObject → TextObject
      // Note: These do NOT need explicit mode switching

      // Delete inside quotes
      "cmd-d cmd-'": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::Quotes"
        ]
      ],

      // Delete inside parentheses
      "cmd-d cmd-9": [
        "action::Sequence",
        [
          "vim::PushDelete",
          ["vim::PushObject", { "around": false }],
          "vim::Parentheses"
        ]
      ],

      // Change inside quotes (delete and enter insert mode)
      "cmd-c cmd-'": [
        "action::Sequence",
        [
          "vim::PushChange",
          ["vim::PushObject", { "around": false }],
          "vim::Quotes"
        ]
      ],

      // Yank (copy) inside word
      "cmd-y cmd-w": [
        "action::Sequence",
        [
          "vim::PushYank",
          ["vim::PushObject", { "around": false }],
          "vim::Word"
        ]
      ],

      // Toggle comment inside quotes
      "cmd-/ cmd-'": [
        "action::Sequence",
        [
          "vim::PushToggleComments",
          ["vim::PushObject", { "around": false }],
          "vim::Quotes"
        ]
      ],

      // Toggle comment inside function arguments
      "cmd-/ cmd-a": [
        "action::Sequence",
        [
          "vim::PushToggleComments",
          ["vim::PushObject", { "around": false }],
          "vim::Argument"
        ]
      ]
    }
  }
]
